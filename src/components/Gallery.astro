---
// Photo/video grid with captions for project pages. Mark portrait items with `tall` to span two rows,
// wide screenshots with `wide` to show them full-width and uncropped, and tall screenshots with
// `narrow` to show them uncropped in their own row at a moderate width.
// Videos play muted on a loop, like a moving photo.
import { Image } from 'astro:assets';

type Item = { alt: string; caption?: string; tall?: boolean; wide?: boolean; narrow?: boolean } & (
	| { src: ImageMetadata; video?: never }
	| { video: string; poster?: ImageMetadata; src?: never }
);

interface Props {
	photos: Item[];
}

const { photos } = Astro.props;
---

<div class="gallery not-content">
	{
		photos.map(({ src, video, poster, alt, caption, tall, wide, narrow }) => (
			<figure class:list={{ tall, wide, narrow }}>
				{video ? (
					<video
						src={video}
						poster={poster?.src}
						aria-label={alt}
						autoplay
						muted
						loop
						playsinline
						preload="metadata"
					/>
				) : (
					src && <Image src={src} alt={alt} width={1000} />
				)}
				{caption && <figcaption>{caption}</figcaption>}
			</figure>
		))
	}
</div>

<style>
	.gallery {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 0.75rem;
		margin-top: 1.5rem;
	}
	figure {
		position: relative;
		margin: 0;
		aspect-ratio: 4 / 3;
		border-radius: 0.75rem;
		overflow: hidden;
		border: 1px solid var(--sl-color-gray-5);
		box-shadow: var(--card-shadow, none);
	}
	figure :global(img),
	figure video {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.3s;
	}
	figure:hover :global(img),
	figure:hover video {
		transform: scale(1.03);
	}

	/* Portrait: span two rows; the media is taken out of flow so it fills without stretching the rows */
	figure.tall {
		aspect-ratio: auto;
		grid-row: span 2;
	}
	figure.tall :global(img),
	figure.tall video {
		position: absolute;
		inset: 0;
	}

	/* Wide and narrow screenshots: own row, natural height, never cropped */
	figure:is(.wide, .narrow) {
		grid-column: 1 / -1;
		aspect-ratio: auto;
	}
	figure.narrow {
		justify-self: center;
		width: min(100%, 24rem);
	}
	figure:is(.wide, .narrow) :global(img),
	figure:is(.wide, .narrow) video {
		height: auto;
	}
	figure:is(.wide, .narrow):hover :global(img),
	figure:is(.wide, .narrow):hover video {
		transform: none;
	}

	figcaption {
		position: absolute;
		inset: auto 0 0 0;
		padding: 1.5rem 0.9rem 0.65rem;
		font-size: var(--sl-text-sm);
		color: #fff;
		background: linear-gradient(transparent, rgba(0, 0, 0, 0.7));
	}
	/* Screenshots are mostly white, so put their caption below instead of over the image */
	figure:is(.wide, .narrow) figcaption {
		position: static;
		padding: 0.6rem 0.9rem;
		color: var(--sl-color-gray-2);
		background: var(--sl-color-gray-7, var(--sl-color-gray-6));
		border-top: 1px solid var(--sl-color-gray-5);
	}

	@media (prefers-reduced-motion: reduce) {
		figure :global(img),
		figure video {
			transition: none;
		}
	}
	@media (max-width: 40rem) {
		.gallery {
			grid-template-columns: 1fr;
		}
		figure.tall {
			grid-row: auto;
			aspect-ratio: 3 / 4;
		}
	}
</style>
