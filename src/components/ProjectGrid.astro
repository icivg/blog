---
import { getProjects } from '../lib';
import ProjectCard from './ProjectCard.astro';

interface Props {
	/** Only show projects with `featured: true`. */
	featured?: boolean;
	limit?: number;
}

const { featured = false, limit } = Astro.props;
let projects = await getProjects();
if (featured) projects = projects.filter((p) => p.data.featured);
if (limit) projects = projects.slice(0, limit);
---

<div class="project-grid not-content">
	{projects.map((project) => <ProjectCard project={project} />)}
</div>

<style>
	.project-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr));
		gap: 1rem;
		margin-top: 1.5rem;
	}
</style>
