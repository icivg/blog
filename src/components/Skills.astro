---
interface Props {
	groups: { label: string; items: string[] }[];
}

const { groups } = Astro.props;
---

<dl class="skills not-content">
	{
		groups.map(({ label, items }) => (
			<div class="group">
				<dt>{label}</dt>
				<dd>
					<ul>
						{items.map((item) => (
							<li>{item}</li>
						))}
					</ul>
				</dd>
			</div>
		))
	}
</dl>

<style>
	.skills {
		display: grid;
		gap: 1.25rem;
		margin-top: 1rem;
	}
	dt {
		font-weight: 600;
		color: var(--sl-color-white);
		margin-bottom: 0.5rem;
	}
	dd {
		margin: 0;
	}
	ul {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		list-style: none;
		padding: 0;
		margin: 0;
	}
	li {
		padding: 0.25rem 0.75rem;
		border-radius: 999px;
		font-size: var(--sl-text-sm);
		background: var(--sl-color-accent-low);
		color: var(--sl-color-accent-high);
		border: 1px solid transparent;
	}
</style>
