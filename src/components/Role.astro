---
// An activity/role block on the About page: heading, role badge, description and a photo strip.
import { Image } from 'astro:assets';

interface Props {
	org: string;
	role: string;
	link?: string;
	photos?: { src: ImageMetadata; alt: string }[];
}

const { org, role, link, photos = [] } = Astro.props;
---

<section class="role not-content">
	<header>
		<h3>{link ? <a href={link} target="_blank" rel="noopener">{org}</a> : org}</h3>
		<span class="badge">{role}</span>
	</header>
	<div class="body"><slot /></div>
	{
		photos.length > 0 && (
			<div class:list={['photos', `count-${Math.min(photos.length, 3)}`]}>
				{photos.map(({ src, alt }) => (
					<figure>
						<Image src={src} alt={alt} width={900} />
					</figure>
				))}
			</div>
		)
	}
</section>

<style>
	.role {
		position: relative;
		margin-top: 2rem;
		padding: 1.5rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 1rem;
		background: var(--sl-color-black);
		overflow: hidden;
	}
	/* Gradient accent bar matching the homepage hero */
	.role::before {
		content: '';
		position: absolute;
		inset: 0 auto 0 0;
		width: 4px;
		background: linear-gradient(180deg, hsl(265, 90%, 62%), hsl(320, 85%, 62%), hsl(25, 95%, 62%));
	}
	header {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem 0.75rem;
	}
	h3 {
		margin: 0;
		font-size: var(--sl-text-h3);
		color: var(--sl-color-white);
	}
	h3 a {
		color: inherit;
		text-decoration: none;
	}
	h3 a:hover {
		color: var(--sl-color-accent-high);
	}
	.badge {
		font-size: var(--sl-text-sm);
		font-weight: 600;
		padding: 0.15rem 0.7rem;
		border-radius: 999px;
		background: var(--sl-color-accent-low);
		color: var(--sl-color-accent-high);
	}
	.body {
		margin-top: 0.75rem;
		color: var(--sl-color-gray-2);
		line-height: 1.7;
	}
	.body :global(a) {
		color: var(--sl-color-text-accent);
		text-underline-offset: 0.2em;
	}
	.body :global(p) {
		margin: 0 0 0.75rem;
	}
	.photos {
		display: grid;
		gap: 0.75rem;
		margin-top: 1rem;
	}
	.count-2 {
		grid-template-columns: 1fr 1fr;
	}
	.count-3 {
		grid-template-columns: repeat(3, 1fr);
	}
	figure {
		margin: 0;
		border-radius: 0.6rem;
		overflow: hidden;
		aspect-ratio: 4 / 3;
	}
	.count-1 figure {
		aspect-ratio: 16 / 9;
	}
	figure :global(img) {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.3s;
	}
	figure:hover :global(img) {
		transform: scale(1.03);
	}
	@media (max-width: 40rem) {
		.count-2,
		.count-3 {
			grid-template-columns: 1fr;
		}
	}
</style>
